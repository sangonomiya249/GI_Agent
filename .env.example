# ==================== 本机 BetterGI 与玩家配置 ====================
# 请填写自己的 UID；不要将真实 .env 提交到 Git。
DEFAULT_UID=

# BetterGI 安装目录。留空时使用 Windows/WSL 的默认安装位置。
BGI_DIR=
BGI_EXE=BetterGI.exe

# 以下名称必须与本机 BetterGI 中实际创建的文件或脚本目录一致。
BGI_ONE_DRAGON_CONFIG_NAME=默认配置.json
BGI_MAP_CONFIG_NAME=地图素材.json
# 敌人与魔物路线组（调度器里的脚本组名）。没有这个组时，Agent 会按敌人名去
# User/ScriptGroup 里找你自己分好的组（如 蕈兽.json / 骗骗花.json / 刀谭.json）。
BGI_ENEMY_CONFIG_NAME=敌人与魔物.json
# 矿物路线组（挖矿）：目标填矿物名，如 水晶块 / 紫晶块 / 星银矿石 / 白铁块 / 铁块 / 魔晶矿 / 萃凝晶 / 虹滴晶 / 石珀
BGI_MINE_CONFIG_NAME=矿物.json
# 食材与炼金路线组：目标填素材名，如 禽肉 / 鱼肉 / 螃蟹 / 蘑菇 / 薄荷 / 甜甜花 / 胡萝卜
BGI_COOK_CONFIG_NAME=食材与炼金.json
# 锄大地路线组（repo/pathing/锄地专区）：小怪2000@mno / 精英400@汐 / 挪德卡莱锄地小怪。
# ⚠️ 和「敌人与魔物」是两件事：敌人与魔物 = 指定魔物/材料刷固定怪点；
#    锄大地 = 不指定魔物、按地区扫图清怪。两边路线名会重名（锄地专区里就有 0_0_飞萤 子目录
#    和“三骗骗花”路线），Agent 用目录前缀做隔离，写错也不会互相抢路线。
BGI_HOE_CONFIG_NAME=锄大地.json
# BetterGI 解包脚本仓库路径追踪项目的位置（自动建组时从这里扫路线）
BGI_AUTO_PATHING_DIR=
# 调度器里没有该类目的总组时，是否自动按 BGI_AUTO_PATHING_DIR/<类目> 生成组文件
# （目前只对「锄大地」这类几百条路线、手工建组很折磨的类目生效）。
# 生成后仍需要在 BetterGI 的「一条龙」界面把它添加/勾选一次（TaskDefinitions 里没登记不会被执行）。
BGI_AUTO_CREATE_ROUTE_GROUP=1
# Agent 往一条龙里加过哪些任务（用于下一轮自动回收，避免残留任务一直挂着 enabled）。
# 一般不用改；`python main.py repair` 会用它清掉 Agent 加过、又跑不起来的任务项（例如历史遗留的 AutoBoss）。
AGENT_TASK_STATE_PATH=memory/agent_registered_tasks.json
# JS 脚本的"自定义配置"（写进 User/ScriptGroup/<脚本组>.json 每个 JS 项目的
# jsScriptSettingsObject；BetterGI 会把它当成 JS 里的 `settings` 对象）。
# 默认关掉两个会干扰挂机的窗口：
#   showEditorOnStart —— 《批量讨伐角色养成材料BOSS》启动时的"BOSS 配置编辑器"遮罩窗口，
#                        默认开启，**必须手点"保存并关闭"脚本才会继续**；
#   showStatusPanel   —— 运行时的悬浮状态面板（多一个抢焦点的窗口）。
# 不认识的键会被 BetterGI 按脚本自己的 settings.json 过滤掉，所以可以写得通用。
BGI_JS_SCRIPT_SETTINGS={"showEditorOnStart": false, "showStatusPanel": false}
# 路线组体量上限与处理策略：
#   shrink（默认）= 自动把组精简成"只有本次要打的路线"，完整清单归档到
#                   User/ScriptGroup/.gi_agent_archive/，下次换目标自动从归档里重新挑
#                   （不用手工拆组，也不会留下几百条 Disabled 造成日志爆发）
#   refuse        = 拒绝启用并告警
#   allow         = 照旧整组开关（BetterGI 崩溃风险自负）
# 背景：BetterGI 会为每条被禁用脚本写一行日志；大组里躺几百条 Disabled 时，
# 跑一半按停止快捷键会让日志瞬间爆发（实测 638/773 行/秒），
# 随后在 WPF 层栈溢出崩溃（0xc00000fd / System.StackOverflowException）。
BGI_MAX_ROUTE_GROUP_SIZE=300
BGI_ROUTE_GROUP_POLICY=shrink
# 等价于 policy=allow，保留兼容
BGI_ALLOW_LARGE_ROUTE_GROUP=0
BGI_GLOBAL_CONFIG_RELATIVE_PATH=User/config.json
BGI_BOSS_CONFIG_RELATIVE_PATH=User/JsScript/批量讨伐角色养成材料BOSS/assets/config/config.json
# 留空时备份、Diff 和事务记录写入 BetterGI/User/GI_AgentBackups。
BGI_BACKUP_DIR=
# 战斗策略（.txt）目录：留空 = BetterGI/User/AutoFight。
# BetterGI 按**平铺**路径解析策略名（User/AutoFight/<策略名>.txt），子目录里的策略要写成 子目录\策略名。
BGI_AUTO_FIGHT_DIR=

# 对话历史保留条数，必须为正整数。
MAX_HISTORY_MESSAGES=20

# 展柜数据的保鲜期（分钟）：超过这个时间就重新拉一次 Enka。
# 启动 Agent 时一定会强制刷新；这个值只决定飞书模式下每条消息要不要重拉，
# 防止把一份过期的展柜快照当成"最新展柜"喂给大模型。
ENV_CONTEXT_TTL_MINUTES=10

# 刷秘境用哪种树脂（说"打 N 次"时写进 BetterGI 的 autoDomainConfig）：
#   原粹树脂20（默认，20 体力一次） / 原粹树脂40 / 浓缩树脂
DOMAIN_RESIN_PREFERENCE=原粹树脂20

# ==================== 米游社个人战绩（可选，补全"不在展柜的角色"）====================
# 展柜一次只放 8 个角色，玩家问起展柜外的角色时 Agent 只能回"展柜里没有"。
# 填了米游社 cookie，就能读到账号下**全部角色**的等级/天赋等级/武器（材料仍由本地字典算）。
#
# ⚠️ cookie 就是账号凭据：只写在这个文件里（.env 已被 .gitignore 忽略），别贴进聊天、别提交仓库。
#    留空 = 完全不启用（一行网络请求都不会发）。
#    怎么拿、怎么验证、过期了怎么办 → docs/MYS_COOKIE.md
MYS_COOKIE=
# 查哪个号：留空 = DEFAULT_UID；再没有就取 cookie 名下第一个原神角色。
MYS_UID=
# 多久拉一次全角色名单（小时，默认 48）。玩家明确要求"别每次启动都拉，1~3 天一次"：
# 只有真的要查展柜外的角色、且缓存比这个时间旧，才会去请求米游社（天赋详情按需单拉）。
MYS_CACHE_TTL_HOURS=48
# 一次对话里最多为几个展柜外角色补天赋详情（每个角色 1 次请求，风控严时别调大）。
MYS_DETAIL_MAX_PER_TURN=3

# DS 签名参数：salt 随米游社 App 版本变化（官方没公开）。默认值是喵喵插件/Yunzai 那套
# 仍在用的国服参数；哪天米游社改版导致签名失效，改这里即可（代码不用动）。
# MYS_SALT=xV8v4Qu54lUKrEYFZkJhB8cuOh9Asafs
# MYS_APP_VERSION=2.40.1

# 扫码登录（Studio 配置页的「扫码登录」/ python -m skills.mys_login --qr）用的是**另一套**参数：
# 走 passport-api，app_id 是**字符串**、App 版本号也不同。它直接换回 v1 ltoken，
# 所以这是"想让养成计算器真的算得出材料"的推荐入口。改版时报 -3005 就更新这几个值。
# MYS_APP_SALT=JwYDpKvLj6MrMqqYU6jTKF17KNO2PXoS
# MYS_APP_VERSION_APP=2.70.1
# MYS_APP_ID=bll8iq97cem8
# 设备指纹与 Android 版本号：少了 device_fp 会被判"设备环境有风险"（-3503）。
# MYS_DEVICE_FP=38d7ee0e96649
# MYS_APP_SYS_VERSION=11

# ==================== 角色养成（米游社养成计算器，可选但强烈推荐）====================
# 事实来源分工（规格书 §41）：
#   米游社养成计算器 = 材料需求来源；米游社背包接口 = 真实库存来源；BetterGI = 只负责执行。
# ⚠️ 这套链路同样依赖上面的 MYS_COOKIE；没配 cookie 时养成页只能显示"未同步"，
#    任何网络请求都不会发。完整说明与排错表 → docs/GROWTH.md
#
# 启动 Studio / Agent 时是否自动同步一次米游社库存（默认开）。
# 关掉不会丢数据：养成页上的「同步米游社库存」按钮随时能手动同步。
GROWTH_STARTUP_SYNC=1
# 自动同步频率：startup=每次启动（默认） / 30=每 30 分钟 / 120=每 2 小时 / manual=只手动。
# ⚠️ 米游社接口有风控，没必要别设太勤（30 分钟已经算频繁）。
GROWTH_SYNC_MODE=startup
# BetterGI 养成任务跑完是否自动重新同步库存再重算缺口（**核心机制**，默认开）。
# 为什么必须开：BetterGI 永远不知道它捡到了多少，库存只能靠"下一次同步"更新。
GROWTH_POST_TASK_SYNC=1
# 库存"多久算过期"（小时）：超过就标 stale，界面必须显示"这不是实时数据"。
# 比 MYS_CACHE_TTL_HOURS（48，角色名单）短得多 —— 材料是每次执行后都要重算的东西。
GROWTH_INVENTORY_STALE_HOURS=12
# 一次规划最多为几个角色去米游社算材料（每个角色 1 次请求；风控严时别调大）
GROWTH_COMPUTE_MAX_PER_PLAN=8
# 同一份目标的材料需求缓存多久（分钟）：反复点「重新规划」不该反复请求米游社。
# 任何一次库存同步 / 目标变更都会让缓存立刻失效。
GROWTH_COMPUTE_CACHE_MINUTES=30
# ★ 执行方式：all＝一次性全部执行（默认，按原本调度把体力任务 + 自由任务一起下发）；
#   stepwise＝分批次：先推总路线详情，再只问第一条「跑不跑」，回 y 就跑这条，
#   跑完自动推下一条；回别的内容就放弃队列、按你说的来。
#   两种方式都会**跳过没有路线的材料**（它们照样显示在明细表里，只是不占批次）。
GROWTH_EXECUTION_MODE=all
# ★ 养成数据源：showcase＝角色展柜 Enka（默认，和聊天上下文一致，但展柜只放 8 个角色
#   且不会主动推送）；calculator＝米游社养成计算器（按养成目标算缺口，选它时会把当前
#   养成计划推送给玩家，含预计培养天数与体力换算）。
GROWTH_DATA_SOURCE=showcase
# ★ 每次启动 Agent 都把「今天要执行的目标」推送给玩家（默认开）。
#   为什么必须推：米游社的「已有 / 还差」是算出来的，BetterGI 跑完那一刻背包还没刷新
#   （同步有延迟），所以"今天该跑什么"只能靠推送告诉你，不能靠玩家自己记。
GROWTH_STARTUP_PUSH=1
# ★ genshin-db（**Node 包**）的安装位置 —— 只有重算"材料族知识表"时才用得到，跑 Agent 不需要。
#   用途：导出秘境开放星期、怪物掉落表、合成配方链（算档位/天数要用）。
#   三种装法任选：
#     ① 在项目根目录 `npm install`（根目录的 package.json 已声明 genshin-db）→ 这里**留空**即可；
#     ② 装在别处（比如全局）→ 填包目录，例如 D:\tools\node_modules\genshin-db；
#     ③ 一次性指定：node scripts/export_genshin_db.js --pkg <目录>。
#   装/更新之后跑：`npm run knowledge`（= 导出 + 重建知识表）。
GENSHIN_DB_PATH=
# 养成计算器的域名与接口路径（高级项，一般留空即可）。
# 默认值已实测可用：域名 api-takumi.mihoyo.com（**不是** api-takumi-static.mihoyo.com，
# 后者是静态资源域，打上去只会得到 404）+ 前缀 /event/e20200928calculate
# + 路径 /v1/avatar/list（图鉴）、/v2/compute（算材料）、/v1/sync/avatar/list（账号角色，需登录）。
# ⚠️ 米游社改版导致 404 时，跑 `python -m skills.mys_calculator --probe`：
#    它会用你的 cookie 把候选路径挨个试一遍，把可用的打出来，填到这里即可（不用改代码）。
MYS_CALC_HOST=
MYS_CALC_WEB_URL=https://act.mihoyo.com/ys/event/calculator/index.html
MYS_CALC_PREFIX=
MYS_CALC_PATH_AVATAR_LIST=
MYS_CALC_PATH_COMPUTE=
MYS_CALC_PATH_MY_ITEMS=
# 【老兜底路径才用】扫码登录的独立浏览器配置目录（留空 = <.studio-profile\mys-login>）。
# ⚠️ 现在的「扫码登录」不再开浏览器窗口（二维码直接画在页面上 / 终端里），所以**正常用不到它**；
# 只有走 `python -m skills.mys_login --start/--finish` 那条手动抄 cookie 的老路时才会用到。
# 想「退出登录」直接把这个目录删掉即可。
MYS_LOGIN_PROFILE_DIR=

# ==================== 世界资源冷却（四类资源、四套刷新规则）====================
# 排期前会先查"这个东西刷了没"：数据来自 BetterGI 自己的日志（玩家手动在 BGI 里跑过的也算），
# 冷却内跑过的不重复跑，只提示"还要等约 N 小时"。
# 时长出处：bilibili wiki「新手教程 · 采集物刷新时间」（社区 wiki，非官方数值）。
#
# ① 地区特产（游戏里标【XX区域特产】的，如霜仙花 / 清水玉 / 月莲）
#    wiki 原文：「特产…在采集后经过 48 小时刷新」
GATHER_COOLDOWN_HOURS=48
# ② 矿物：wiki 按档写 —— 铁块/白铁块「上次刷新后的次日」、星银矿石「第二日」、
#    水晶块/紫晶块「第三日」（服务器 0 点），魔晶块「每天 6 点」。
#    这里按小时近似，并可逐材料覆盖（skills/gather_cooldown.py 的 MATERIAL_HOURS：
#    铁块/白铁块 24、星银矿石 48、水晶块/紫晶块 72、魔晶块 24、电气水晶 48、夜泊石/石珀 72）。
MINE_COOLDOWN_HOURS=72
# ③ 食材与炼金：wiki 原文「大部分食材…每日凌晨 0 点刷新」→ 按"距上次 24 小时"近似
COOK_COOLDOWN_HOURS=24
# ④ 敌人与魔物：wiki 明确写了动物/晶蝶类「采集后 12 小时刷新以及凌晨四点刷新」，
#    普通魔物社区通行说法也是 12 小时
HUNT_COOLDOWN_HOURS=12
# 玩家明确说「强制采集 / 强制跑」时是否照跑（1=照跑，0=一律拦）；对所有类别都生效
GATHER_COOLDOWN_ALLOW_FORCE=1
# "算跑完"的路线比例（%）：只在这类资源的路线跑到这个比例时才认为跑完、开始冷却。
# 为什么要它：防闪退隔离带会给没被点名的材料也打开一条路线，只跑 1 条不该算跑完。
GATHER_COOLDOWN_MIN_ROUTE_PERCENT=80

# ==================== 防闪退隔离带（脚本组里"穿插其它材料"的那些路线）====================
# 背景：BetterGI 会给脚本组里每条 Disabled 路线写一行日志；几百条的大组在跑一半按停止时
# 日志会瞬间爆发（实测 550~700 行/秒），随后可能在 WPF 层栈溢出崩溃（0xc00000fd）。
# 原实现的做法是"每连续 150 条 Disabled 就强制打开一条"来截断，代价是组里会穿插你没点名的材料。
#
# ⚠️ "连续 N 条会触发 bug"这个具体阈值没有权威出处（BGI 源码/文档里查不到）。
#    想自己验证就设 0（完全不用隔离带），观察一段时间即可；关掉后资源冷却也回到"正常冷却"。
BGI_FORCE_ENABLE_BAND=1
# 每连续 N 条禁用路线插一条隔离带（默认 150，与原实现一致；旧文档写的 180 无出处）
BGI_FORCE_ENABLE_AFTER_DISABLED=150
# MYS_CLIENT_TYPE=5

# 等待 BetterGI 一条龙跑完的超时分钟数（默认 360 = 6 小时）。
# 超时后哨兵会停止监控，并在终端给出提示。
BGI_WATCH_TIMEOUT_MINUTES=360

# ==================== BGI 正在跑任务时的等待（不用重新下一次指令）====================
# 实测踩过的坑：一条龙 12:34:40 就跑完了，BGI 窗口还开着、空闲时也会零碎写日志，
# 12:36 再下指令时被判成"正在跑任务"直接拒绝，玩家只好把同一句话重下一遍。
# 现在改成"等它跑完自动继续"：日志里出现结束标记（一条龙和配置组任务结束 / 任务被取消 /
# 主窗体退出）就接着执行本轮计划；最多等 BGI_WAIT_RUNNING_TASK_MINUTES 分钟。
BGI_WAIT_RUNNING_TASK_MINUTES=20
# 等待期间的轮询间隔（秒）
BGI_RUNNING_TASK_POLL_SECONDS=10

# ==================== 原神窗口前后台兜底 ====================
# 背景：BetterGI 的模拟输入要求**游戏保持前台**，它会每秒检查一次前台窗口，
# 不是原神就打一行「当前获取焦点的窗口为: X，不是原神，暂停」并停在那里 —— 看起来就是卡死。
# 实测（玩家日志）：一条龙跑到一半出现 73 次这种暂停，前台分别是 QQ / Studio / Win 搜索。
#
# ① 触发一条龙之后，自动把原神切到前台一次（点 y 就是"开始跑图"，这一次是符合意图的；置 0 关闭）
BGI_FOCUS_ON_LAUNCH=1
# ② 运行中反复把原神抢回前台：**默认关**——你可能正在用电脑（QQ/浏览器），反复抢会打断你。
#    打开后最多抢 BGI_FOCUS_GUARD_MAX_TRIES 次，抢不到就罢手并说明（不提示是不会静默的）
BGI_FOCUS_GUARD=0
BGI_FOCUS_GUARD_MAX_TRIES=3
# ③ 连续几次巡检发现"前台不是原神"才提示（一次巡检 15 秒，2 次≈30 秒，避免误报）
BGI_FOCUS_GUARD_STRIKES=2

# ==================== LLM 配置 ====================
LLM_PROVIDER=github
MODEL_NAME=gpt-4o-mini
GITHUB_TOKEN=

# 单次请求的读超时（秒）与自动重试次数。
# 不设时 OpenAI SDK 默认读超时是 600s —— 推理型模型 + 上万 token 的 prompt 可能真的
# 等十多分钟才报 "Request timed out."，所以这里显式给它一个更合理的值。
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# 默认走流式（长回答不会撞读超时）；个别中转不支持时可以设 0 退回一次性请求。
LLM_STREAM=1

# OpenAI：LLM_PROVIDER=openai 时使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA：LLM_PROVIDER=nvidia 时使用。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 通用 OpenAI 兼容接口：LLM_PROVIDER=custom 时使用。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 本地模型：LLM_PROVIDER=local 时使用。
LOCAL_BASE_URL=
LOCAL_API_KEY=local

# ==================== 飞书配置（可选） ====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 回话模式：on（默认）= 审批屏 / 完成报告照旧发到飞书；
# off = **单向模式**：飞书只用来下指令，Agent 的回话（审批屏 / 完成报告 / 报错）
#       全部只显示在终端与 Studio 日志里 —— 指令飞书 → 本机 Agent，Agent 不回飞书。
#       注意：单向模式下审批要在电脑上做（终端输 y / t，或 Studio 的输入框）。
FEISHU_REPLY_MODE=on
# 点 Studio 的「启动 Agent」时，是否顺带启动飞书服务端（python feishu_main.py）。默认 0。
# 为什么默认关：它是 Webhook 服务（监听 5000 端口），**公网不可达（没做内网穿透）时收不到任何消息**，
# 白占一个进程。填了上面两项、并且确实配了内网穿透，再设成 1。
AUTO_START_FEISHU_BOT=0

# ==================== QQ 官方机器人（可选，轻量接口） ====================
# 在 https://q.qq.com 建一个机器人，拿到 AppID 与 AppSecret（密钥）填这里。
# 启动：python main.py qq      （或 python qq_main.py；--check 会取 token 并试连网关）
# 说明：只用官方 WebSocket 网关 + REST，**不需要** LangBot / qq-botpy 等额外依赖；
#      消息走和飞书同一套 Agent 逻辑（规划 / 审批 / 配置事务全部复用）。
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 谁能指挥 Agent（逗号分隔的 openid，不是 QQ 号！）。留空且没开 ALLOW_ANYONE 时会拒收指令，
# 并把对方 openid 回给他 —— 先随便发一句，把 ID 抄到这里再重启即可。
QQ_BOT_ALLOWED_USERS=
# 危险开关：允许任何 QQ 用户下指令（会真的改 BetterGI 配置并启动游戏自动化）。默认 0
QQ_BOT_ALLOW_ANYONE=0
# 订阅哪些事件（位掩码）：默认 群聊/单聊(1<<25) + 频道@我(1<<30) + 频道私信(1<<12) + 互动事件(1<<26)
# = 1174409216。群聊/单聊需要在开放平台申请「群聊/单聊消息」权限；只要群聊填 33554432（1<<25）即可。
# ⚠️ 1<<26（互动事件）是审批按钮点击用的，去掉它按钮就点不动了。
QQ_BOT_INTENTS=
# 断线重连间隔（秒）
QQ_BOT_RECONNECT_SECONDS=5
# 回复详略：compact（默认）= QQ 只收"要执行什么"的审批屏，完整推理留在电脑端日志；
# full = 连大模型推理正文一起发（手机上会刷屏，一条审批可能被切成好几条）；
# off = **单向模式**：QQ 只用来下指令，Agent 的回话（审批屏 / 完成报告 / 报错）一句都不发，
#       全部只显示在终端与 Studio 日志里 —— 指令 QQ → 本机 Agent，Agent 不回 QQ。
#       注意：单向模式下审批要在电脑上做（终端输 y / t，或 Studio 的输入框），
#             手机上将收不到任何反馈（这是刻意的）。
QQ_BOT_REPLY_MODE=compact
# 审批屏是否挂按钮（✅ 执行 / 🧪 仅改配置 / 🚫 取消，点一下等于回复 y / t / 取消）。默认 1。
# ⚠️ 按钮需要在 QQ 开放平台开通：自定义按钮 =【内邀开通】，模板按钮 =【申请使用】。
#    没开通时发送会失败，程序会自动退回纯文本并提示一次，功能不受影响；想彻底不试就设 0。
#    拿不到按钮权限也能有"按钮"：python main.py qq --setup-menu 会配好单聊窗口底部的
#    自定义菜单（✅ 执行 / 🧪 测试 / 🚫 取消，官方不要求内邀），点击把指令填进输入框。
QQ_BOT_BUTTONS=1
# 进阶：单聊快捷菜单的功能 ID → 按钮标识（形如 "我的ID=approve,另一个ID=test"）。
# 如果你在开放平台管理端已配了快捷菜单，把它的功能 ID 写在这里就能被识别。
QQ_BOT_MENU_COMMANDS=
# 点 Studio 的「启动 Agent」时，是否顺带把 QQ 机器人也唤醒（内嵌在「远程通道」页里看日志）。默认 1。
# 只有填了 QQ_BOT_APPID / QQ_BOT_SECRET 才会真的启动；没填就跳过，并在通道日志里写明缺哪一项。
AUTO_START_QQ_BOT=1
# 进阶：一般不用填。默认先 GET /gateway 取接入点（失败会退回 /websocket/，再失败就直接连这个地址）。
QQ_BOT_WS_URL=

# ==================== 版本与更新（可选）====================
# 检查 GitHub 上有没有新 release（Studio 概览页那张「版本」卡 / python main.py update）。
# 只读 release 信息：不下载、不改任何文件，更新与否由你自己决定（程序只给命令与链接）。
# 本地版本取仓库根的 VERSION 文件；没有就退回 git describe。设 0 = 完全不碰网络。
UPDATE_CHECK=1
# 检查哪个仓库（fork 出去以后改成自己的 owner/repo）
UPDATE_REPO=sangonomiya249/GI_Agent
# 结果缓存多久（小时）：GitHub 匿名接口每小时只有 60 次，所以默认 6 小时才真查一次
# （Studio「系统 → 版本更新」页点「检查更新」会忽略缓存、立刻重查）
UPDATE_CHECK_HOURS=6
# 单次请求超时（秒）：卡网时别让页面跟着卡
UPDATE_CHECK_TIMEOUT=6
# 检查失败也缓存一小会儿（分钟）：否则离线时每次打开那一页都要白等一串重试
UPDATE_CHECK_ERROR_MINUTES=10
# 走哪个代理访问 GitHub。留空 = 依次试「系统/环境变量代理 → 直连 → 本机 127.0.0.1:7890」。
# 开着 Clash 之类但检查更新总失败时，把它的地址填这里（例如 http://127.0.0.1:7890）。
UPDATE_PROXY=
# 额外的 HTTPS CA 证书（pem）。报 SSLError / certificate verify failed 时填：
# 说明本机有代理或杀软在中间解密 HTTPS，Python 自带证书库不认那个 CA。
# 留空时程序会自己依次试：requests 自带证书 → REQUESTS_CA_BUNDLE / SSL_CERT_FILE
# → 仓库里的 .git\win-ca-bundle.pem（本项目的 git 就是靠它连上 GitHub 的）。
UPDATE_CA_BUNDLE=
