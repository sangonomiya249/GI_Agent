studio.log
studio-access.log
studio-host.log
.studio-profile/
.studio-lib/

# PyInstaller
*.spec

# Local Agent Memory
#   ⚠️ 这些是**你个人的运行数据**（对话记录 / 展柜快照 / 手记的采集冷却 …），
#   里面会带 UID、角色、QQ 会话 id，绝对不要提交到 GitHub。
memory/chat_context.json
memory/agent_registered_tasks.json
memory/qq_pending_notices.json
memory/qq_bot.lock
memory/mys_characters.json
memory/gather_cooldown_manual.json
memory/update_check.json
memory/current_state.json
memory/target_config.json

# BetterGI 关闭流程的临时状态（scripts/stop_bettergi.ps1 使用）
scripts/*.pids
scripts/*.log
